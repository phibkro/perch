{
  "name": "perch-durable",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PERCH_CATALOGS", "class_name": "PerchCatalog" },
      { "name": "PERCH_SESSIONS", "class_name": "PerchSession" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PerchCatalog", "PerchSession"] }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "perch-artifacts" }],
  "vars": { "PERCH_ALLOWED_ORIGINS": "[]" }
}

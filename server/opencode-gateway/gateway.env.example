# Copy to a private file outside this checkout and replace both passwords.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-upstream-password

PERCH_OPENCODE_USERNAME=perch
# This short placeholder deliberately fails startup validation.
PERCH_OPENCODE_PASSWORD=replace-me
PERCH_OPENCODE_HOST=127.0.0.1
PERCH_OPENCODE_PORT=4097
# Browser only: comma-separated exact origins, without a trailing slash.
# Native Android/iOS does not need a browser origin.
PERCH_OPENCODE_ORIGINS=

{
  "name": "perch",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk": "node scripts/build-android-apk.mjs",
    "verify": "node src/session/verify.cjs",
    "preview:export": "node scripts/export-preview.mjs",
    "dev:android": "node scripts/develop-android.mjs",
    "dev:mcp": "node scripts/start-expo-mcp.mjs",
    "apk:development": "node scripts/build-android-apk.mjs --development",
    "tools:doctor": "node tooling/doctor.mjs",
    "tools:install": "bun install --cwd tooling --frozen-lockfile && node tooling/install-maestro.mjs",
    "test:device": "node tooling/run.mjs maestro test .maestro/smoke.yml",
    "verify:artifacts": "node src/artifacts/verify.cjs",
    "release:check": "node scripts/ci-android-version.mjs",
    "release:version": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@assistant-ui/react-native": "0.1.46",
    "@expo/metro-runtime": "57.0.16",
    "@expo/ui": "57.0.21",
    "cn": "0.4.0",
    "expo": "57.0.26",
    "expo-clipboard": "57.0.2",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-haptics": "57.0.3",
    "expo-image-manipulator": "57.0.20",
    "expo-image-picker": "57.0.20",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.24",
    "lowlight": "3.3.0",
    "lucide-react-native": "1.52.0",
    "marked": "18.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-marked": "8.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "babel-preset-expo": "57.0.13",
    "expo-mcp": "0.2.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "packageManager": "bun@1.4.2"
}
